---
import BaseLayout from '../layouts/BaseLayout.astro';

// Auto-load all project files from src/data/projects/
const projectFiles = import.meta.glob('../data/projects/*.ts', { eager: true });
// Sort by `order` in each project file: lower numbers show first.
// Projects without an `order` go to the end, sorted by title.
const projects = Object.values(projectFiles)
  .map((mod: any) => mod.default)
  .sort((a, b) =>
    (a.order ?? Infinity) - (b.order ?? Infinity) || a.title.localeCompare(b.title)
  );

// Auto-load recent blog posts (3 most recent)
const blogFiles = import.meta.glob('../data/blog/*.ts', { eager: true });
const allPosts = Object.values(blogFiles)
  .map((mod: any) => mod.default)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const recentPosts = allPosts.slice(0, 3);
---

<BaseLayout title="Tygo van Gorp - Graphics Programmer">
  
  <!-- Hero Section -->
  <section id="home">
    <div class="hero">
      <h1>Tygo van Gorp</h1>
      <p class="subtitle">Graphics & Rendering Programmer</p>
      <p class="intro">
        Specializing in shader development and real-time rendering techniques. 
        Focused on performance optimization and modern rendering pipelines.
      </p>
    </div>
    <a href="#projects" class="scroll-indicator">
      <span>Scroll</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </section>

  <!-- Projects Section -->
  <section id="projects">
    <h2 class="section-title">Projects</h2>
    {projects.length === 0 ? (
      <div class="no-projects">
        <p>No projects found. Add project files to <code>src/data/projects/</code></p>
      </div>
    ) : (
      <div class="project-filter" id="project-filter" hidden>
        <span>Showing projects tagged <strong id="filter-label"></strong></span>
        <button type="button" class="filter-clear" id="filter-clear">Show all projects</button>
      </div>
      <div class="projects-list">
        {projects.map((project, index) => (
          <article class="project" data-project-index={index} data-tags={JSON.stringify(project.tech ?? [])}>
            <div class="project-media">
              {project.image
                ? <img src={project.image} alt={project.title} loading="lazy" />
                : <div class="placeholder">Add project video/image (16:9)</div>
              }
            </div>

            <div class="project-header">
              <h3>{project.title}</h3>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="github-link">GitHub →</a>
              )}
            </div>

            <p class="project-description">{project.description}</p>

            <div class="tech-list">
              {(project.tech ?? []).map(item => (
                <button type="button" class="tech-tag" data-tag={item} aria-pressed="false">{item}</button>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <!-- Blog Section -->
  <section id="blog">
    <h2 class="section-title">Recent Posts</h2>
    {recentPosts.length === 0 ? (
      <div class="no-posts">
        <p>No blog posts yet. Add posts to <code>src/data/blog/</code></p>
      </div>
    ) : (
      <div class="blog-grid">
        {recentPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="blog-card">
            <time class="blog-date">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <h3>{post.title}</h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-tags">
              {post.tags.slice(0, 3).map(tag => (
                <span class="tag-small">{tag}</span>
              ))}
            </div>
            <span class="read-more-inline">Read more →</span>
          </a>
        ))}
      </div>
    )}
    {allPosts.length > 3 && (
      <div class="view-all">
        <a href="/blog" class="view-all-link">View all posts →</a>
      </div>
    )}
  </section>

  <!-- About Section -->
  <section id="about">
    <h2 class="section-title">About</h2>
    <div class="about-content">
      <div class="about-text">
        <p>
          [Add your background here - education, experience, what drives your interest in graphics programming]

            <table>
              <tbody>
                <tr>
                  <td>Breda University Of Applied Sciences</td>
                  <td>Creative Media & Game Technologies - Programming</td>
                  <td>Sep 2025 to Apr 2028</td>
                </tr>
                <tr>
                  <td>Cambridge</td>
                  <td>B2 First English</td>
                  <td>Aug 2022</td>
                </tr>
              </tbody>
            </table>

        </p>
        <p>
          [Current focus areas, what you're learning, what types of projects you're interested in]
        </p>
      </div>
      
      <div class="skills-contact">
        <div class="skills">
          <h3>Technical Skills</h3>
          <ul>
            <li>GLSL / HLSL shader programming</li>
            <li>OpenGL / DirectX / PS5</li>
            <li>Real-time rendering techniques</li>
            <li>Performance profiling & optimization</li>
            <li>C++</li>
          </ul>
        </div>
        
        <div class="contact">
          <h3>Contact</h3>
          <p>
            <a href="mailto:Tygo.vanGorp@outlook.com">Tygo.vanGorp@outlook.com</a><br>
            <a href="https://github.com/TygovGorp" target="_blank">GitHub</a><br>
            <a href="https://www.linkedin.com/in/tygo-van-gorp" target="_blank">LinkedIn</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal -->
  <div id="project-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <button class="modal-close" aria-label="Close modal">×</button>
      <div class="modal-body">
        <div class="modal-header">
          <h2 id="modal-title"></h2>
          <a id="modal-github" target="_blank" class="modal-github-link">View on GitHub →</a>
        </div>
        
        <div id="modal-media" class="modal-media"></div>
        
        <div class="modal-section">
          <h3>Overview</h3>
          <p id="modal-full-description"></p>
        </div>
        
        <div class="modal-section">
          <h3>Key Features</h3>
          <ul id="modal-features"></ul>
        </div>
        
        <div class="modal-section">
          <h3>Technical Details</h3>
          <div id="modal-tech-tags" class="tech-list"></div>
        </div>
        
        <div class="modal-section">
          <h3>Code Sample</h3>
          <pre><code id="modal-code"></code></pre>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ projects }}>
    if (projects && projects.length > 0) {
      const modal = document.getElementById('project-modal');
      const cards = document.querySelectorAll('.project');
      const filterBar = document.getElementById('project-filter');
      const filterLabel = document.getElementById('filter-label');
      let activeTag = null;

      // ---------- Tag filtering ----------
      // Clicking a tag shows only projects with that tag.
      // Clicking the same tag again (or "Show all projects") clears the filter.
      function setFilter(tag) {
        activeTag = tag === activeTag ? null : tag;

        cards.forEach(card => {
          const tags = JSON.parse(card.dataset.tags || '[]');
          card.hidden = activeTag !== null && !tags.includes(activeTag);
        });

        document.querySelectorAll('.project .tech-tag').forEach(btn => {
          const on = btn.dataset.tag === activeTag;
          btn.classList.toggle('active', on);
          btn.setAttribute('aria-pressed', String(on));
        });

        filterBar.hidden = activeTag === null;
        filterLabel.textContent = activeTag ?? '';
      }

      document.getElementById('filter-clear').addEventListener('click', () => setFilter(null));

      // ---------- Card clicks: tags filter, GitHub opens, anything else opens the modal ----------
      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          const tagBtn = e.target.closest('.tech-tag');
          if (tagBtn) {
            setFilter(tagBtn.dataset.tag);
            return;
          }
          if (e.target.closest('a')) return; // let links work normally
          openModal(projects[Number(card.dataset.projectIndex)]);
        });
      });

      // ---------- Modal ----------
      function openModal(project) {
        document.getElementById('modal-title').textContent = project.title;

        const gh = document.getElementById('modal-github');
        if (project.github) {
          gh.href = project.github;
          gh.hidden = false;
        } else {
          gh.hidden = true;
        }

        document.getElementById('modal-full-description').textContent = project.fullDescription || project.description;

        const modalMedia = document.getElementById('modal-media');
        modalMedia.innerHTML = '';
        if (project.image) {
          const img = document.createElement('img');
          img.src = project.image;
          img.alt = project.title;
          modalMedia.appendChild(img);
        } else {
          modalMedia.innerHTML = '<div class="placeholder">Project media</div>';
        }

        const featuresList = document.getElementById('modal-features');
        featuresList.innerHTML = '';
        (project.features || []).forEach(feature => {
          const li = document.createElement('li');
          li.textContent = feature;
          featuresList.appendChild(li);
        });

        // Tags in the modal also filter: close the modal and jump to the filtered list
        const techContainer = document.getElementById('modal-tech-tags');
        techContainer.innerHTML = '';
        (project.tech || []).forEach(tech => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tech-tag';
          btn.textContent = tech;
          btn.addEventListener('click', () => {
            closeModal();
            if (activeTag !== tech) setFilter(tech);
            document.getElementById('projects').scrollIntoView();
          });
          techContainer.appendChild(btn);
        });

        document.getElementById('modal-code').textContent = project.codeSnippet || '// No code sample available';

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      document.querySelector('.modal-close').addEventListener('click', closeModal);
      document.querySelector('.modal-backdrop').addEventListener('click', closeModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
      });
    }
  </script>
</BaseLayout>

<style>
  /* Page width: BaseLayout's `section` rule is scoped to BaseLayout, so it never
     reaches these sections. Without this, every section runs edge to edge. */
  section {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Hero */
  #home {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 2rem;
    height: 100vh;
    min-height: 100vh;
    max-width: none;
  }

  .hero {
    text-align: center;
    max-width: 700px;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #fff;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #888;
    margin-bottom: 2rem;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #bbb;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    animation: bounce 2s infinite;
    transition: color 0.2s;
  }

  .scroll-indicator:hover {
    color: #999;
  }

  .scroll-indicator svg {
    width: 20px;
    height: 20px;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Section Titles */
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: #fff;
    text-align: center;
  }

  /* Projects */
  .no-projects {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
  }

  .no-projects code {
    color: #888;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .project[hidden] {
    display: none;
  }

  /* Filter status bar */
  .project-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: #111;
    border: 1px solid #222;
    border-radius: 6px;
    color: #bbb;
  }

  .project-filter[hidden] {
    display: none;
  }

  .project-filter strong {
    color: #fff;
    font-weight: 600;
  }

  .filter-clear {
    background: none;
    border: none;
    border-bottom: 1px solid #555;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s;
  }

  .filter-clear:hover {
    border-color: #fff;
  }

  .project {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #111;
    border: 1px solid #222;
    border-radius: 8px;
    padding: 1.5rem;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .project:hover {
    transform: translateY(-8px);
    border-color: #444;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
  }

  .project:hover .project-media img,
  .project:hover .project-media .placeholder {
    border-color: #333;
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }

  .project h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.3;
    color: #fff;
    overflow-wrap: anywhere;
  }

  .github-link {
    flex-shrink: 0;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 1px solid #555;
    transition: border-color 0.2s;
  }

  .github-link:hover {
    border-color: #fff;
  }

  /* The media box is an invisible 16:9 slot that keeps every card in a row aligned.
     The visible frame (background, border, rounded corners) sits on the image itself,
     so it shrinks with the image instead of staying 16:9. */
  .project-media,
  .modal-media {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
  }

  .project-media {
    margin-bottom: 1.25rem;
  }

  .placeholder,
  .modal-media :global(.placeholder) {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    background: #1a1a1a;
    border: 1px solid #222;
    border-radius: 6px;
    transition: border-color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
  }

  /* Absolutely positioned so the image can't stretch the 16:9 slot;
     inset 0 + margin auto centers it, max-width/height shrink it to fit. */
  .project-media img,
  .modal-media :global(img) {
    position: absolute;
    inset: 0;
    margin: auto;
    box-sizing: border-box;
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    background: #1a1a1a;
    border: 1px solid #222;
    border-radius: 6px;
    transition: border-color 0.3s ease;
  }

  .modal-media :global(img),
  .modal-media :global(.placeholder) {
    border-radius: 8px;
  }

  .project-description {
    flex-grow: 1;
    margin: 0 0 1.25rem;
    line-height: 1.7;
    color: #bbb;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-list :global(.tech-tag) {
    background: #1a1a1a;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.4;
    text-align: left;
    color: #999;
    border: 1px solid #222;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .tech-list :global(.tech-tag:hover) {
    color: #fff;
    border-color: #555;
  }

  .tech-list :global(.tech-tag.active) {
    background: #fff;
    border-color: #fff;
    color: #0a0a0a;
  }

  .tech-list :global(.tech-tag:focus-visible),
  .filter-clear:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Blog Cards on Homepage */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: #111;
    border: 1px solid #222;
    border-radius: 8px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: #444;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
  }

  .blog-date {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 0.75rem;
    display: block;
  }

  .blog-card h3 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .blog-excerpt {
    color: #bbb;
    line-height: 1.6;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag-small {
    background: #1a1a1a;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
    color: #777;
    border: 1px solid #222;
  }

  .read-more-inline {
    color: #888;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .blog-card:hover .read-more-inline {
    color: #fff;
  }

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  .view-all-link {
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid #555;
    transition: border-color 0.2s;
    padding-bottom: 0.25rem;
  }

  .view-all-link:hover {
    border-color: #fff;
  }

  .no-posts {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
  }

  .no-posts code {
    color: #888;
  }

  /* About */
  .about-content {
    max-width: 900px;
    margin: 0 auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th, td {
    border-right: 1px solid #444;
    padding: 0.75rem 1rem;
    text-align: left;
  }

  th:last-child, td:last-child {
    border-right: none;
  }

  th {
    background: #1a1a1a;
    color: #fff;
  }

  tr:nth-child(even) {
    background: #111;
  }

  .about-text {
    margin-bottom: 3rem;
  }

  .about-text p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: #bbb;
  }

  .skills-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .skills h3,
  .contact h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .skills ul {
    list-style-position: inside;
    line-height: 2;
  }

  .contact a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid #555;
    transition: border-color 0.2s;
  }

  .contact a:hover {
    border-color: #fff;
  }

  /* Modal */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 1000px;
    max-height: 90vh;
    background: #0a0a0a;
    border: 1px solid #333;
    border-radius: 12px;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  }

  .modal-close {
    position: sticky;
    top: 1rem;
    right: 1rem;
    float: right;
    width: 40px;
    height: 40px;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 50%;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
  }

  .modal-close:hover {
    background: #222;
    border-color: #555;
  }

  .modal-body {
    padding: 3rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .modal-header h2 {
    font-size: 1.5rem;
    color: #fff;
    margin: 0;
  }

  .modal-github-link {
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid #555;
    transition: border-color 0.2s;
  }

  .modal-github-link:hover {
    border-color: #fff;
  }

  .modal-github-link[hidden] {
    display: none;
  }

  .modal-media {
    margin-bottom: 2rem;
  }

  .modal-section {
    margin-bottom: 2.5rem;
  }

  .modal-section h3 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 1rem;
  }

  .modal-section p {
    line-height: 1.8;
    color: #bbb;
    white-space: pre-line;
  }

  .modal-section ul {
    list-style-position: inside;
    line-height: 2;
    color: #bbb;
  }

  .modal-section pre {
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .projects-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    nav {
      padding: 1.5rem 2rem;
    }

