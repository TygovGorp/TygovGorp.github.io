---
import BaseLayout from '../layouts/BaseLayout.astro';

const cvUrl: string | null = null;

// Auto-load blog posts, newest first
const blogFiles = import.meta.glob('../data/blog/*.ts', { eager: true });
const allPosts = Object.values(blogFiles)
  .map((mod: any) => mod.default)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const recentPosts = allPosts.slice(0, 3);
const postsBySlug = new Map(allPosts.map((post) => [post.slug, post]));

// Auto-load all project files from src/data/projects/
const projectFiles = import.meta.glob('../data/projects/*.ts', { eager: true });
const projects = Object.entries(projectFiles)
  .map(([path, mod]: [string, any]) => {
    const project = mod.default;
    const id = path.split('/').pop()!.replace(/\.ts$/, '');

    const blogPosts = (project.blogPosts ?? []).map((slug: string) => {
      const post = postsBySlug.get(slug);
      if (!post) {
        throw new Error(`Project "${id}" links to blog post "${slug}", but no post in src/data/blog/ has that slug.`);
      }
      return { slug, title: post.title };
    });

    return { ...project, id, blogPosts };
  })
  .sort((a, b) =>
    (a.order ?? Infinity) - (b.order ?? Infinity) || a.title.localeCompare(b.title)
  );

const allTags = [...new Set(projects.flatMap((p) => p.tech ?? []))].sort((a, b) => a.localeCompare(b));
const tagHues: Record<string, number> = Object.fromEntries(
  allTags.map((tag, i) => [tag, Math.round((25 + (i * 360) / allTags.length) % 360)])
);

---

<BaseLayout title="Tygo van Gorp - Graphics Programmer">
  
  <!-- Hero Section -->
  <section id="home">
    <div class="hero">
      <h1>Tygo van Gorp</h1>
      <p class="subtitle">Graphics & Rendering Programmer</p>
      <p class="intro">
        Graphics programmer with a passion for ray tracing, shaders, performance, team management and
        <a href="/?project=catch-my-drift#projects" data-open-project="catch-my-drift">technical leadership</a>.
      </p>
      <div class="hero-actions">
        <a href="#projects" class="button button-primary">View projects</a>
        {cvUrl && <a href={cvUrl} class="button" target="_blank" rel="noopener">Download CV</a>}
        <a href="mailto:Tygo.vanGorp@outlook.com" class="button">Get in touch</a>
      </div>
    </div>
    <a href="#projects" class="scroll-indicator">
      <span>Scroll</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </section>

  <!-- Projects Section -->
  <section id="projects">
    <h2 class="section-title">Projects</h2>
    {projects.length === 0 ? (
      <div class="no-projects">
        <p>No projects found. Add project files to <code>src/data/projects/</code></p>
      </div>
    ) : (
      <div class="project-filter" id="project-filter" hidden>
        <span>Showing projects tagged <strong id="filter-label"></strong></span>
        <button type="button" class="filter-clear" id="filter-clear">Show all projects</button>
      </div>
      <div class="projects-list">
        {projects.map((project, index) => (
          <article class="project" data-project-index={index} data-project-id={project.id} data-tags={JSON.stringify(project.tech ?? [])}>
            <div class="project-media">
              {project.image
                ? <img src={project.image} alt={project.title} loading="lazy" />
                : <div class="placeholder" aria-hidden="true"></div>
              }
            </div>

            <div class="project-header">
              <h3>{project.title}</h3>
              <div class="project-links">
                {project.blogPosts.length > 0 && (
                  <a href={`/blog/${project.blogPosts[0].slug}`} class="github-link">Write-up →</a>
                )}
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener" class="github-link">GitHub →</a>
                )}
              </div>
            </div>

            <p class="project-description">{project.description}</p>

            <div class="tech-list">
              {(project.tech ?? []).map(item => (
                <button type="button" class="tech-tag" data-tag={item} aria-pressed="false" style={`--tag-hue: ${tagHues[item]}`}>{item}</button>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <!-- Blog Section -->
  <section id="blog">
    <h2 class="section-title">Recent Posts</h2>
    {recentPosts.length === 0 ? (
      <div class="no-posts">
        <p>No blog posts yet. Add posts to <code>src/data/blog/</code></p>
      </div>
    ) : (
      <div class="blog-grid">
        {recentPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="blog-card">
            <time class="blog-date">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <h3>{post.title}</h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-tags">
              {post.tags.slice(0, 3).map(tag => (
                <span class="tag-small">{tag}</span>
              ))}
            </div>
            <span class="read-more-inline">Read more →</span>
          </a>
        ))}
      </div>
    )}
    {allPosts.length > 3 && (
      <div class="view-all">
        <a href="/blog" class="view-all-link">View all posts →</a>
      </div>
    )}
  </section>

  <!-- About Section -->
  <section id="about">
    <h2 class="section-title">About</h2>
    <div class="about-content">
      <div class="about-text">
        <div class="education">
          <h3>Education</h3>
            <table>
              <tbody>
                <tr>
                  <td>Breda University of Applied Sciences</td>
                  <td>Creative Media & Game Technologies - Programming</td>
                  <td>Sep 2025 to Apr 2028</td>
                </tr>
                <tr>
                  <td>Cambreur College</td>
                  <td>Bilingual Havo</td>
                  <td>Sep 2019 to Apr 2025</td>
                </tr>
                <tr>
                  <td>Cambridge</td>
                  <td>B2 First English</td>
                  <td>Aug 2022</td>
                </tr>
              </tbody>
            </table>
        </div>
        <p>
          My main focus is real-time rendering with a passion for ray/path tracing. I've built path tracers on the CPU
          and in DX12, worked on PS5 rendering, and I write about what I learn on my blog.
        </p>
        <p>
          Next to the technical work, I've found that I enjoy technical leadership. Being tech lead on
          Catch My Drift taught me to plan work for a team, review code, and keep programming in line
          with design and art. I want to keep growing in both, toward a lead programmer role.
        </p>
      </div>
      
      <div class="skills-contact">
        <div class="skills">
          <h3>Technical Skills</h3>
          {/*
            NOTE (feedback point 4): make these specific. Every graphics portfolio says
            "real-time rendering" and "profiling"; naming the actual techniques and tools is
            more convincing and matches the keywords recruiters search job applications for.
            Only list things you've actually built or used. Ideas from your own projects:
              - Instead of "Real-time rendering techniques": "Deferred shading", "PBR with
                image-based lighting", "Shadow mapping", "Frustum culling"
              - Instead of "Ray/Path Tracing": "Path tracing with Multiple Importance Sampling",
                "Hardware ray tracing (DXR)" if your DX12 tracer uses it
              - Instead of "Performance profiling & optimization": name the tools, e.g.
                "Profiling with PIX / RenderDoc / Nsight / Razor (PS5)"
              - "OpenGL / DirectX 12 / PS5" could include "OpenGL ES" (Raspberry Pi project)
          */}
          <ul>
            <li>GLSL / HLSL shader programming</li>
            <li>OpenGL / DirectX 12 / PS5</li>
            <li>Real-time rendering techniques</li>
            <li>Ray/Path Tracing</li>
            <li>Performance profiling & optimization</li>
            <li>C++</li>
          </ul>
        </div>
        
        <div class="side-column">
          <div class="skills">
            <h3>Technical Leadership</h3>
            <ul>
              <li>Sprint planning & task breakdown</li>
              <li>Code review</li>
              <li>Collaborating with non-technical team members</li>
            </ul>
          </div>

          <div class="contact">
            <h3>Contact</h3>
            <p>
              <a href="mailto:Tygo.vanGorp@outlook.com">Tygo.vanGorp@outlook.com</a><br>
              <a href="https://github.com/TygovGorp" target="_blank">GitHub</a><br>
              <a href="https://www.linkedin.com/in/tygo-van-gorp" target="_blank">LinkedIn</a>
              {cvUrl && <><br><a href={cvUrl} target="_blank" rel="noopener">CV (PDF)</a></>}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal -->
  <div id="project-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <button class="modal-close" aria-label="Close modal">×</button>
      <div class="modal-body">
        <div class="modal-header">
          <h2 id="modal-title"></h2>
          <a id="modal-github" target="_blank" class="modal-github-link">View on GitHub →</a>
        </div>
        
        <div id="modal-media" class="modal-media"></div>
        
        <div class="modal-section">
          <h3>Overview</h3>
          <p id="modal-full-description"></p>
        </div>

        <div class="modal-section" id="modal-writeups-section" hidden>
          <h3>Write-up</h3>
          <ul id="modal-writeups" class="modal-list"></ul>
        </div>

        <div class="modal-section" id="modal-contributions-section" hidden>
          <h3>My Contributions</h3>
          <ul id="modal-contributions" class="modal-list"></ul>
        </div>
        
        <div class="modal-section">
          <h3>Key Features</h3>
          <ul id="modal-features" class="modal-list"></ul>
        </div>
        
        <div class="modal-section">
          <h3>Technical Details</h3>
          <div id="modal-tech-tags" class="tech-list"></div>
        </div>
        
        <div class="modal-section" id="modal-code-section" hidden>
          <h3>Code Sample</h3>
          <pre><code id="modal-code"></code></pre>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ projects, tagHues }}>
    if (projects && projects.length > 0) {
      const modal = document.getElementById('project-modal');
      const cards = document.querySelectorAll('.project');
      const filterBar = document.getElementById('project-filter');
      const filterLabel = document.getElementById('filter-label');
      let activeTag = null;

      // ---------- Tag filtering ----------
      // Clicking a tag shows only projects with that tag.
      // Clicking the same tag again (or "Show all projects") clears the filter.
      function setFilter(tag) {
        activeTag = tag === activeTag ? null : tag;

        cards.forEach(card => {
          const tags = JSON.parse(card.dataset.tags || '[]');
          card.hidden = activeTag !== null && !tags.includes(activeTag);
        });

        document.querySelectorAll('.project .tech-tag').forEach(btn => {
          const on = btn.dataset.tag === activeTag;
          btn.classList.toggle('active', on);
          btn.setAttribute('aria-pressed', String(on));
        });

        filterBar.hidden = activeTag === null;
        filterLabel.textContent = activeTag ?? '';
        if (activeTag !== null) filterLabel.style.setProperty('--tag-hue', tagHues[activeTag]);
      }

      document.getElementById('filter-clear').addEventListener('click', () => setFilter(null));

      // ---------- Card clicks: tags filter, GitHub opens, anything else opens the modal ----------
      cards.forEach(card => {
        card.addEventListener('click', (e) => {
          const tagBtn = e.target.closest('.tech-tag');
          if (tagBtn) {
            setFilter(tagBtn.dataset.tag);
            return;
          }
          if (e.target.closest('a')) return; // let links work normally
          openModal(projects[Number(card.dataset.projectIndex)]);
        });
      });

      // ---------- Direct links to a project ----------
      // /?project=<file name> opens that project's popup when the page loads
      // (used by blog posts to link back). Links on this page with
      // data-open-project open the popup without reloading.
      const findProject = (id) => projects.find(p => p.id === id);

      document.querySelectorAll('[data-open-project]').forEach(link => {
        link.addEventListener('click', (e) => {
          const project = findProject(link.dataset.openProject);
          if (!project) return; // unknown id: let the link navigate normally
          e.preventDefault();
          openModal(project);
        });
      });

      // ---------- Video ----------
      // Turns a YouTube link (watch?v=, youtu.be/, /shorts/, /embed/, /live/) into its video id.
      function getYouTubeId(url) {
        try {
          const u = new URL(url);
          const host = u.hostname.replace(/^(www\.|m\.)/, '');
          if (host === 'youtu.be') return u.pathname.split('/')[1] || null;
          if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
            if (u.pathname === '/watch') return u.searchParams.get('v');
            const m = u.pathname.match(/^\/(embed|shorts|live)\/([^/]+)/);
            if (m) return m[2];
          }
        } catch (e) { /* not a valid URL */ }
        return null;
      }

      // Reads a start time like t=90, t=90s or t=1m30s from the link, in seconds.
      function getStartSeconds(url) {
        try {
          const t = new URL(url).searchParams.get('t') || new URL(url).searchParams.get('start');
          if (!t) return 0;
          if (/^\d+s?$/.test(t)) return parseInt(t, 10);
          const m = t.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/);
          return m ? (+m[1] || 0) * 3600 + (+m[2] || 0) * 60 + (+m[3] || 0) : 0;
        } catch (e) { return 0; }
      }

      // Returns the element to show in the popup for a project's videoUrl,
      // or null when there is no video (or the link format isn't recognised).
      function createVideoElement(project) {
        const url = project.videoUrl;
        if (!url) return null;

        const ytId = getYouTubeId(url);
        if (ytId) {
          const start = getStartSeconds(url);
          const iframe = document.createElement('iframe');
          // youtube-nocookie: no tracking cookies until the visitor presses play
          iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(ytId)}?rel=0${start ? `&start=${start}` : ''}`;
          iframe.title = `${project.title} video`;
          iframe.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.allowFullscreen = true;
          iframe.loading = 'lazy';
          return iframe;
        }

        // A video file of your own, e.g. '/media/project/x/demo.mp4'
        if (/\.(mp4|webm|ogg)(\?|#|$)/i.test(url)) {
          const video = document.createElement('video');
          video.src = url;
          video.controls = true;
          video.preload = 'metadata';
          video.playsInline = true;
          if (project.image) video.poster = project.image;
          return video;
        }

        console.warn(`videoUrl for "${project.title}" isn't a YouTube link or .mp4/.webm/.ogg file, showing the image instead:`, url);
        return null;
      }

      // ---------- Modal ----------
      function openModal(project) {
        document.getElementById('modal-title').textContent = project.title;

        // Put the project in the address bar so the open popup can be shared as a link
        history.replaceState(null, '', `?project=${encodeURIComponent(project.id)}${location.hash}`);

        const gh = document.getElementById('modal-github');
        if (project.github) {
          gh.href = project.github;
          gh.hidden = false;
        } else {
          gh.hidden = true;
        }

        document.getElementById('modal-full-description').textContent = project.fullDescription || project.description;

        // Write-up: links to related blog posts (blogPosts in the project file)
        const writeups = project.blogPosts || [];
        const writeupList = document.getElementById('modal-writeups');
        writeupList.innerHTML = '';
        writeups.forEach(post => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/blog/${post.slug}`;
          a.textContent = `${post.title} →`;
          li.appendChild(a);
          writeupList.appendChild(li);
        });
        document.getElementById('modal-writeups-section').hidden = writeups.length === 0;

        const modalMedia = document.getElementById('modal-media');
        modalMedia.innerHTML = '';
        const videoEl = createVideoElement(project);
        if (videoEl) {
          modalMedia.appendChild(videoEl);
        } else if (project.image) {
          const img = document.createElement('img');
          img.src = project.image;
          img.alt = project.title;
          modalMedia.appendChild(img);
        }
        // No video and no image: hide the media area instead of showing an empty box
        modalMedia.hidden = modalMedia.childElementCount === 0;

        // My contributions: only shown when the project file lists some
        const contributions = project.contributions || [];
        const contribList = document.getElementById('modal-contributions');
        contribList.innerHTML = '';
        contributions.forEach(item => {
          const li = document.createElement('li');
          li.textContent = item;
          contribList.appendChild(li);
        });
        document.getElementById('modal-contributions-section').hidden = contributions.length === 0;

        const featuresList = document.getElementById('modal-features');
        featuresList.innerHTML = '';
        (project.features || []).forEach(feature => {
          const li = document.createElement('li');
          li.textContent = feature;
          featuresList.appendChild(li);
        });

        // Tags in the modal also filter: close the modal and jump to the filtered list
        const techContainer = document.getElementById('modal-tech-tags');
        techContainer.innerHTML = '';
        (project.tech || []).forEach(tech => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tech-tag';
          btn.style.setProperty('--tag-hue', tagHues[tech]);
          btn.textContent = tech;
          btn.addEventListener('click', () => {
            closeModal();
            if (activeTag !== tech) setFilter(tech);
            document.getElementById('projects').scrollIntoView();
          });
          techContainer.appendChild(btn);
        });

        // Code sample: only shown when the project file has a codeSnippet
        const code = (project.codeSnippet || '').trim();
        document.getElementById('modal-code').textContent = code;
        document.getElementById('modal-code-section').hidden = code === '';

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        // Remove the media so a playing video stops instead of continuing in the background
        document.getElementById('modal-media').innerHTML = '';
        modal.classList.remove('active');
        document.body.style.overflow = '';
        history.replaceState(null, '', `${location.pathname}${location.hash}`);
      }

      document.querySelector('.modal-close').addEventListener('click', closeModal);
      document.querySelector('.modal-backdrop').addEventListener('click', closeModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
      });

      const linkedProject = findProject(new URLSearchParams(location.search).get('project'));
      if (linkedProject) openModal(linkedProject);
    }
  </script>
</BaseLayout>

<style>
  /* Page width: BaseLayout's `section` rule is scoped to BaseLayout, so it never
     reaches these sections. Without this, every section runs edge to edge. */
  section {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Hero */
  #home {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 2rem;
    height: 100vh;
    min-height: 100vh;
    max-width: none;
  }

  .hero {
    text-align: center;
    max-width: 700px;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #fff;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #888;
    margin-bottom: 2rem;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #bbb;
  }

  .intro a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid #555;
    transition: border-color 0.2s;
  }

  .intro a:hover {
    border-color: #fff;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border: 1px solid #444;
    border-radius: 6px;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .button:hover {
    border-color: #fff;
  }

  .button-primary {
    background: #fff;
    border-color: #fff;
    color: #0a0a0a;
  }

  .button-primary:hover {
    background: #ddd;
    border-color: #ddd;
  }

  .button:focus-visible,
  .intro a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    animation: bounce 2s infinite;
    transition: color 0.2s;
  }

  .scroll-indicator:hover {
    color: #999;
  }

  .scroll-indicator svg {
    width: 20px;
    height: 20px;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Section Titles */
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: #fff;
    text-align: center;
  }

  /* Projects */
  .no-projects {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
  }

  .no-projects code {
    color: #888;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .project[hidden] {
    display: none;
  }

  /* Filter status bar */
  .project-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: #111;
    border: 1px solid #222;
    border-radius: 6px;
    color: #bbb;
  }

  .project-filter[hidden] {
    display: none;
  }

  .project-filter strong {
    color: #fff;
    color: oklch(0.85 0.12 var(--tag-hue, 0));
    font-weight: 600;
  }

  .filter-clear {
    background: none;
    border: none;
    border-bottom: 1px solid #555;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s;
  }

  .filter-clear:hover {
    border-color: #fff;
  }

  .project {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #111;
    border: 1px solid #222;
    border-radius: 8px;
    padding: 1.5rem;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .project:hover {
    transform: translateY(-8px);
    border-color: #444;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
  }

  .project:hover .project-media img,
  .project:hover .project-media .placeholder {
    border-color: #333;
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }

  .project h3 {
    margin: 0;
    font-size: 1.3rem;
